{
  "manifest_version": 2,
  "name": "Lantern TV",
  "version": "0.1.1",
  "description": "Send a playing HLS or MP4 video from Firefox to your paired Lantern TV.",
  "browser_specific_settings": {"gecko": {"id": "lantern-tv@lantern.local", "strict_min_version": "115.0"}},
  "permissions": ["nativeMessaging", "webRequest", "tabs", "activeTab", "https://*/*"],
  "background": {"scripts": ["core.js", "background.js"]},
  "content_scripts": [{"matches": ["https://*/*"], "js": ["core.js", "content.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_start"}],
  "browser_action": {"default_title": "Play on Lantern TV", "default_popup": "popup.html"},
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
